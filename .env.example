NODE_ENV=production
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vinken_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=vinken_company

# Optional: comma-separated origins only if the website and API use separate hosts.
CORS_ORIGINS=

# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replacearandomsecretatleastharacterslong
